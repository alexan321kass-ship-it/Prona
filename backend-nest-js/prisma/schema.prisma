generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auditoria {
  id_auditoria   Int      @id @default(autoincrement())
  fecha_evento   DateTime @default(now()) 
  accion         String   
  tabla_afectada String?  
  registro_id    Int?
  detalles       String?  
  ip_direccion   String?  
  id_usuario     Int?
  usuario        usuario? @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario])
}

model permiso {
  id_permiso  Int           @id @default(autoincrement())
  nombre      String        @unique 
  descripcion String?       
  permiso_rol permiso_rol[]
}

model permiso_rol {
  id_rol     Int
  id_permiso Int
  permiso    permiso @relation(fields: [id_permiso], references: [id_permiso], onDelete: Cascade)
  rol        rol     @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)

  @@id([id_rol, id_permiso])
  @@index([id_permiso])
}

model rol {
  id_rol      Int           @id @default(autoincrement())
  nombre_rol  String        @unique 
  permiso_rol permiso_rol[]
  usuario     usuario[]
}

model categoria {
  id_categoria        Int        @id @default(autoincrement())
  nombre_categoria    String     
  descripcion         String?    
  estado              Boolean?   @default(true)
  fecha_creacion      DateTime?  @default(now()) 
  fecha_actualizacion DateTime?  @default(now()) 
  producto            producto[]
}

model cliente {
  id_cliente        Int          @id @default(autoincrement())
  nombre_cliente    String       
  identificacion    String       @unique 
  correo_cliente    String?      
  telefono_cliente  String?      
  direccion_cliente String?      
  cotizacion        cotizacion[]
  pedido            pedido[]
  venta             venta[]
}

model cotizacion {
  id_cotizacion      Int                  @id @default(autoincrement())
  fecha_cotizacion   DateTime?            @default(now()) 
  fecha_vigencia     DateTime             
  estado             cotizacion_estado?   @default(Pendiente)
  id_usuario         Int
  id_cliente         Int
  usuario            usuario              @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict)
  cliente            cliente              @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict)
  detalle_cotizacion detalle_cotizacion[]

  @@index([id_cliente])
  @@index([id_usuario])
}

model detalle_cotizacion {
  id_detalle_cotizacion Int        @id @default(autoincrement())
  id_cotizacion         Int
  id_producto           Int
  cantidad              Int
  precio_unitario       Decimal    
  cotizacion            cotizacion @relation(fields: [id_cotizacion], references: [id_cotizacion], onUpdate: Restrict)
  producto              producto   @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict)

  @@index([id_cotizacion])
  @@index([id_producto])
}

model detalle_devolucion {
  id_detalle_devolucion Int                        @id @default(autoincrement())
  id_devolucion         Int
  id_producto           Int
  cantidad              Int
  precio_unitario       Decimal                    
  estado_producto       devolucion_estado_producto @default(Apto)
  devolucion            devolucion                 @relation(fields: [id_devolucion], references: [id_devolucion], onUpdate: Restrict)
  producto              producto                   @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict)

  @@index([id_devolucion])
  @@index([id_producto])
}

model detalle_venta {
  id_detalle_venta Int      @id @default(autoincrement())
  id_venta         Int
  id_producto      Int
  cantidad         Int
  precio_unitario  Decimal  
  venta            venta    @relation(fields: [id_venta], references: [id_venta], onUpdate: Restrict)
  producto         producto @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict)

  @@index([id_producto])
  @@index([id_venta])
}

model devolucion {
  id_devolucion      Int                  @id @default(autoincrement())
  fecha_devolucion   DateTime?            @default(now()) 
  motivo             String               
  id_venta           Int
  id_usuario         Int
  detalle_devolucion detalle_devolucion[]
  venta              venta                @relation(fields: [id_venta], references: [id_venta], onUpdate: Restrict)
  usuario            usuario              @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict)

  @@index([id_venta])
  @@index([id_usuario])
}

model notificacion {
  id_notificacion    Int       @id @default(autoincrement())
  fecha_notificacion DateTime? @default(now()) 
  mensaje            String    
  id_pedido          Int
  pedido             pedido    @relation(fields: [id_pedido], references: [id_pedido], onUpdate: Restrict)

  @@index([id_pedido])
}

model pedido {
  id_pedido     Int                   @id @default(autoincrement())
  fecha_pedido  DateTime?             @default(now()) 
  estado_pedido pedido_estado_pedido? @default(Pendiente)
  id_cliente    Int
  id_usuario    Int
  notificacion  notificacion[]
  cliente       cliente               @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict)
  usuario       usuario               @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict)
  venta         venta[]

  @@index([id_cliente])
  @@index([id_usuario])
}

model producto {
  id_producto           Int                     @id @default(autoincrement())
  codigo_interno        String?                 @unique 
  nombre_producto       String                  
  descripcion           String?                 
  precio                Decimal                 
  stock                 Int?                    @default(0)
  imagen_url            String?                 
  imagen_public_id      String?                 
  estado                Boolean                 @default(true)
  id_categoria          Int
  detalle_cotizacion    detalle_cotizacion[]
  detalle_devolucion    detalle_devolucion[]
  detalle_venta         detalle_venta[]
  movimiento_inventario movimiento_inventario[]
  categoria             categoria               @relation(fields: [id_categoria], references: [id_categoria], onUpdate: Restrict)

  @@index([id_categoria])
}

model movimiento_inventario {
  id_movimiento   Int                        @id @default(autoincrement())
  fecha           DateTime?                  @default(now()) 
  tipo_movimiento movimiento_inventario_tipo
  cantidad        Int
  motivo          String?                    
  id_producto     Int
  id_usuario      Int
  producto        producto                   @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict)
  usuario         usuario                    @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict)

  @@index([id_producto])
  @@index([id_usuario])
}

model usuario {
  id_usuario                 Int                     @id @default(autoincrement())
  primer_nombre              String                  
  primer_apellido            String                  
  tipo_documento             usuario_tipo_documento
  numero_documento           String                  @unique 
  correo                     String                  @unique 
  contrasena                 String                  
  estado                     Boolean?                @default(true)
  requiere_cambio_contrasena Boolean                 @default(true)
  id_rol                     Int
  auditoria                  auditoria[]
  cotizacion                 cotizacion[]
  devolucion                 devolucion[]
  movimiento_inventario      movimiento_inventario[]
  pedido                     pedido[]
  rol                        rol                     @relation(fields: [id_rol], references: [id_rol], onUpdate: Restrict)
  venta                      venta[]

  @@index([id_rol])
}

model venta {
  id_venta      Int                 @id @default(autoincrement())
  fecha_venta   DateTime?           @default(now()) 
  estado_venta  venta_estado_venta? @default(Pendiente)
  subtotal      Decimal             
  descuento     Decimal?            @default(0.00) 
  impuestos     Decimal?            @default(0.00) 
  total         Decimal?            
  id_pedido     Int?
  id_cliente    Int?
  id_usuario    Int
  detalle_venta detalle_venta[]
  devolucion    devolucion[]
  pedido        pedido?             @relation(fields: [id_pedido], references: [id_pedido], onDelete: Restrict, onUpdate: Restrict)
  usuario       usuario             @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict)
  cliente       cliente?            @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict)

  @@index([id_pedido])
  @@index([id_usuario])
  @@index([id_cliente])
}

enum cotizacion_estado {
  Pendiente
  Aprobada
  Rechazada
}

enum pedido_estado_pedido {
  Pendiente
  Recibido
  Preparacion @map("Preparación")
  Despachado
  Entregado
  Cancelado
}

enum venta_estado_venta {
  Pendiente
  Pagada
  Cancelada
}

enum usuario_tipo_documento {
  CC @map("Cédula de ciudadanía")
  TI @map("Tarjeta de identidad")
  CE @map("Cédula de extranjería")
}

enum devolucion_estado_producto {
  Apto
  Descarte
}

enum movimiento_inventario_tipo {
  Ingreso
  Salida
  Ajuste
}
